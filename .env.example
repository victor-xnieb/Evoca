# Nunca guardes contraseñas reales en este archivo ni lo renombres dentro de Git.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# URL con Connection pooling activado en Neon (host con "-pooler").
# Se usa para el tráfico normal de la aplicación.
DATABASE_URL=

# URL directa de la misma rama (Connection pooling desactivado).
# Se usa únicamente con USE_UNPOOLED_DATABASE=True para migraciones.
DATABASE_URL_UNPOOLED=
USE_UNPOOLED_DATABASE=False

# Versiones de los textos legales. Cambiarlas obliga a solicitar un nuevo consentimiento.
EVOCA_TERMS_VERSION=draft-v1
EVOCA_PRIVACY_VERSION=draft-v1
EVOCA_HEALTH_DATA_VERSION=draft-v1

