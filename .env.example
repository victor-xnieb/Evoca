# Nunca guardes contraseñas reales en este archivo ni lo renombres dentro de Git.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Orígenes del frontend autorizados por CORS, separados por coma. Sin comodines.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL con Connection pooling activado en Neon (host con "-pooler").
# Se usa para el tráfico normal de la aplicación.
DATABASE_URL=

# URL directa de la misma rama (Connection pooling desactivado).
# Se usa únicamente con USE_UNPOOLED_DATABASE=True para migraciones.
DATABASE_URL_UNPOOLED=
USE_UNPOOLED_DATABASE=False

# Versiones de los textos legales. Cambiarlas obliga a solicitar un nuevo consentimiento.
EVOCA_TERMS_VERSION=draft-v1
EVOCA_PRIVACY_VERSION=draft-v1
EVOCA_HEALTH_DATA_VERSION=draft-v1

# Sugerencia de emoción con IA (HU8). La clave se crea en https://aistudio.google.com y se
# escribe solo en .env (nunca en Git). Sin clave, la app funciona sin sugerencia.
EVOCA_AI_PROVIDER=gemini
EVOCA_AI_API_KEY=
EVOCA_AI_MODEL=gemini-3.5-flash-lite
EVOCA_AI_THINKING_LEVEL=minimal
EVOCA_AI_TIMEOUT=2.0
EVOCA_AI_MIN_CONFIDENCE=0.6
# Espera máxima (segundos) al agrupar huellas en recuerdos sugeridos (HU9).
EVOCA_AI_MEMORY_TIMEOUT=15
# Búsqueda por significado (HU12).
EVOCA_AI_EMBEDDING_MODEL=gemini-embedding-2
EVOCA_AI_EMBEDDING_DIMENSIONS=768
EVOCA_AI_EMBED_TIMEOUT=10
EVOCA_SEARCH_EMBED_PER_REQUEST=40
EVOCA_SEARCH_MIN_SIMILARITY=0.6
EVOCA_SEARCH_SPREAD=0.1
# HU13: huellas que reconoce cada pedido de estadísticas y espera máxima por llamada.
EVOCA_STATS_EXTRACT_PER_REQUEST=80
EVOCA_AI_ELEMENTS_TIMEOUT=15
# HU14: espera máxima para preparar el resumen semanal.
EVOCA_AI_WEEKLY_TIMEOUT=15
# HU15: espera máxima para calcular las islas.
EVOCA_AI_ISLANDS_TIMEOUT=20

# Mapa de recuerdos (HU10): afinidad mínima (0 a 1) para unir dos recuerdos y máximo de conexiones por recuerdo.
EVOCA_MAP_MIN_AFFINITY=0.4
EVOCA_MAP_MAX_LINKS=4

# Cuentas de demostración (python manage.py seed_demo). En local no hacen falta; en un
# despliegue (DJANGO_DEBUG=False) son obligatorias. Ver docs/DESPLIEGUE.md.
EVOCA_DEMO_PASSWORD=
EVOCA_DEMO_PIN=

